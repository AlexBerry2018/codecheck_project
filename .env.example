# Copy to .env to override defaults. All values below are the demo defaults.
# JWT_SECRET must also be pasted into kong/kong.yml (consumers[0].jwt_secrets[0].secret):
# declarative Kong config does not read environment variables.
JWT_SECRET=dev-only-change-me-dev-only-change-me-0123456789
INTERNAL_TOKEN=dev-internal-token
POSTGRES_PASSWORD=postgres
ADMIN_EMAIL=admin@codecheck.local
ADMIN_PASSWORD=admin-change-me
TEACHER_INVITE_CODE=teacher-invite

# Host ports (all bound to 127.0.0.1); change when the default is already taken on your machine
# POSTGRES_PORT=5432
# MONGO_PORT=27017
# VALKEY_PORT=6379
# KAFKA_PORT=29092
# COURSES_PORT=8001
# SUBMISSIONS_PORT=8002
# GRADER_PORT=8003

{
  "info": {
    "name": "CodeCheck",
    "description": "Run in order. Base URL is Kong (http://localhost:8000). Tokens and ids are stored in collection variables by the test scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8000"
    },
    {
      "key": "teacher_token",
      "value": ""
    },
    {
      "key": "student_token",
      "value": ""
    },
    {
      "key": "course_id",
      "value": ""
    },
    {
      "key": "assignment_id",
      "value": ""
    },
    {
      "key": "submission_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth (Kong: 5 запросов/мин с IP)",
      "item": [
        {
          "name": "Register teacher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/register",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"teacher\",\n  \"invite_code\": \"teacher-invite\"\n}"
            }
          }
        },
        {
          "name": "Register student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/register",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login teacher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.collectionVariables.set(\"teacher_token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.collectionVariables.set(\"student_token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Courses and assignments (courses-service)",
      "item": [
        {
          "name": "Create course (teacher)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/courses",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "courses"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{teacher_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Python\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.collectionVariables.set(\"course_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List courses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/courses",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "courses"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{student_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Enroll (student)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base}}/api/courses/{{course_id}}/enroll",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "courses",
                "{{course_id}}",
                "enroll"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{student_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Create assignment (teacher)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/courses/{{course_id}}/assignments",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "courses",
                "{{course_id}}",
                "assignments"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{teacher_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sum\",\n  \"description\": \"a + b\",\n  \"time_limit_ms\": 2000,\n  \"memory_limit_mb\": 128,\n  \"tests\": [\n    {\n      \"stdin\": \"1 2\\n\",\n      \"expected_stdout\": \"3\"\n    },\n    {\n      \"stdin\": \"10 20\\n\",\n      \"expected_stdout\": \"30\"\n    },\n    {\n      \"stdin\": \"-5 5\\n\",\n      \"expected_stdout\": \"0\",\n      \"is_hidden\": true\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.collectionVariables.set(\"assignment_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List assignments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/courses/{{course_id}}/assignments",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "courses",
                "{{course_id}}",
                "assignments"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{student_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get assignment (student: public tests only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/assignments/{{assignment_id}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "assignments",
                "{{assignment_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{student_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Update tests (teacher) -> tests_version + 1, event assignment.updated",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/assignments/{{assignment_id}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "assignments",
                "{{assignment_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{teacher_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tests\": [\n    {\n      \"stdin\": \"1 2\\n\",\n      \"expected_stdout\": \"3\"\n    },\n    {\n      \"stdin\": \"10 20\\n\",\n      \"expected_stdout\": \"30\"\n    },\n    {\n      \"stdin\": \"-5 5\\n\",\n      \"expected_stdout\": \"0\",\n      \"is_hidden\": true\n    },\n    {\n      \"stdin\": \"7 8\\n\",\n      \"expected_stdout\": \"15\"\n    }\n  ]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Submissions (submissions-service)",
      "item": [
        {
          "name": "Submit solution -> 202 queued",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/submissions",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "submissions"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{student_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "assignment_id",
                  "value": "{{assignment_id}}",
                  "type": "text"
                },
                {
                  "key": "code",
                  "value": "a, b = map(int, input().split())\nprint(a + b)\n",
                  "type": "text"
                }
              ]
            },
            "description": "Repeat with the SAME Idempotency-Key value to see the Idempotent-Replay header. Use a `file` form field instead of `code` to upload a .py file."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.collectionVariables.set(\"submission_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get status and per-test result",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/submissions/{{submission_id}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "submissions",
                "{{submission_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{student_token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Poll until status != queued."
          }
        },
        {
          "name": "My attempts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/submissions?assignment_id={{assignment_id}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "submissions"
              ],
              "query": [
                {
                  "key": "assignment_id",
                  "value": "{{assignment_id}}"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{student_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Leaderboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/leaderboard/{{assignment_id}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "leaderboard",
                "{{assignment_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{student_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Regrade all (teacher)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base}}/api/submissions/assignments/{{assignment_id}}/regrade",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "submissions",
                "assignments",
                "{{assignment_id}}",
                "regrade"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{teacher_token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}